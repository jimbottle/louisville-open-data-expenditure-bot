# Keep the build context small. Neither Dockerfile copies these; without this
# file every `docker build` shipped the 531 MB of CSVs (plus the second city's
# data, tests, eval results and .git) to the daemon for nothing.
.git
.beads
.claude
__pycache__
**/__pycache__
*.pyc
.env
.venv
venv
tests
eval
docs
spike
graph
infra
monitoring
tools
data_cincinnati
# Not copied by either Dockerfile, but part of the build context: every edit
# here changed the CDK image-asset hash and forced a needless image rebuild
# and function update on the next deploy.
.github
*.md
Dockerfile
canonical_seed.py
pull_arcgis.py
pull_socrata.py
refresh_data.py
warm_cache.py
# Data: only the two serving artifacts Dockerfile.lambda bakes in.
data/*
!data/lou.duckdb
!data/rag_documents.duckdb
