{
  "Version": "2012-10-17",
  "Comment": "Deploy-time ceiling, part 1 of 2: what may be BUILT, every resource scoped to the lou-* namespace. Part 2 (guardrails) carries IAM/STS and every Deny. See README.",
  "Statement": [
    {
      "Sid": "CloudFormationOnLouStacksOnly",
      "Effect": "Allow",
      "Action": "cloudformation:*",
      "Resource": [
        "arn:aws:cloudformation:us-east-1:${AWS_ACCOUNT_ID}:stack/Lou*/*",
        "arn:aws:cloudformation:us-east-1:${AWS_ACCOUNT_ID}:stack/CDKToolkit-Lou/*"
      ]
    },
    {
      "Sid": "CloudFormationReadOnlyGlobal",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:ListStacks",
        "cloudformation:GetTemplateSummary",
        "cloudformation:ValidateTemplate"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LambdaOnLouFunctions",
      "Effect": "Allow",
      "Action": "lambda:*",
      "Resource": [
        "arn:aws:lambda:us-east-1:${AWS_ACCOUNT_ID}:function:lou-*",
        "arn:aws:lambda:us-east-1:${AWS_ACCOUNT_ID}:function:lou-*:*"
      ]
    },
    {
      "Sid": "LambdaListAndPublicLayerRead",
      "Effect": "Allow",
      "Action": [
        "lambda:ListFunctions",
        "lambda:GetAccountSettings",
        "lambda:GetLayerVersion"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DynamoDBOnLouTables",
      "Effect": "Allow",
      "Action": "dynamodb:*",
      "Resource": [
        "arn:aws:dynamodb:us-east-1:${AWS_ACCOUNT_ID}:table/lou-*",
        "arn:aws:dynamodb:us-east-1:${AWS_ACCOUNT_ID}:table/lou-*/index/*"
      ]
    },
    {
      "Sid": "DynamoDBListOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:ListTables",
        "dynamodb:DescribeLimits"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3OnLouAndCdkAssetBuckets",
      "Comment": "Buckets must be lou-<purpose>-<account>-<region> (see README naming rules); plus the lou0 CDK asset bucket. ResourceAccount pin blocks a same-named bucket in another account.",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::lou-*-${AWS_ACCOUNT_ID}-us-east-1",
        "arn:aws:s3:::lou-*-${AWS_ACCOUNT_ID}-us-east-1/*",
        "arn:aws:s3:::cdk-lou0-assets-${AWS_ACCOUNT_ID}-us-east-1",
        "arn:aws:s3:::cdk-lou0-assets-${AWS_ACCOUNT_ID}-us-east-1/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "${AWS_ACCOUNT_ID}"
        }
      }
    },
    {
      "Sid": "S3ListAllBucketsIsAccountLevelOnly",
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets",
        "s3:GetBucketLocation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EcrOnLouAndCdkImageRepos",
      "Effect": "Allow",
      "Action": "ecr:*",
      "Resource": [
        "arn:aws:ecr:us-east-1:${AWS_ACCOUNT_ID}:repository/lou-*",
        "arn:aws:ecr:us-east-1:${AWS_ACCOUNT_ID}:repository/cdk-lou0-container-assets-${AWS_ACCOUNT_ID}-us-east-1"
      ]
    },
    {
      "Sid": "EcrAuthTokenHasNoResourceScope",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "LogsOnLouGroups",
      "Effect": "Allow",
      "Action": "logs:*",
      "Resource": [
        "arn:aws:logs:us-east-1:${AWS_ACCOUNT_ID}:log-group:/aws/lambda/lou-*",
        "arn:aws:logs:us-east-1:${AWS_ACCOUNT_ID}:log-group:/aws/lambda/lou-*:*",
        "arn:aws:logs:us-east-1:${AWS_ACCOUNT_ID}:log-group:/lou/*",
        "arn:aws:logs:us-east-1:${AWS_ACCOUNT_ID}:log-group:/lou/*:*"
      ]
    },
    {
      "Sid": "LogsDescribeIsAccountLevelOnly",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudWatchAlarmsOnLouOnly",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:EnableAlarmActions",
        "cloudwatch:DisableAlarmActions",
        "cloudwatch:TagResource"
      ],
      "Resource": "arn:aws:cloudwatch:us-east-1:${AWS_ACCOUNT_ID}:alarm:lou-*"
    },
    {
      "Sid": "CloudWatchReadIsAccountLevelOnly",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:DescribeAlarms",
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListMetrics"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SnsOnLouTopics",
      "Comment": "Alarm notifications: one lou-* topic with an email subscription.",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:DeleteTopic",
        "sns:GetTopicAttributes",
        "sns:SetTopicAttributes",
        "sns:Subscribe",
        "sns:Unsubscribe",
        "sns:ListSubscriptionsByTopic",
        "sns:TagResource",
        "sns:UntagResource",
        "sns:ListTagsForResource"
      ],
      "Resource": "arn:aws:sns:us-east-1:${AWS_ACCOUNT_ID}:lou-*"
    },
    {
      "Sid": "SchedulerOnLouSchedules",
      "Effect": "Allow",
      "Action": "scheduler:*",
      "Resource": [
        "arn:aws:scheduler:us-east-1:${AWS_ACCOUNT_ID}:schedule/lou-*/*",
        "arn:aws:scheduler:us-east-1:${AWS_ACCOUNT_ID}:schedule-group/lou-*"
      ]
    },
    {
      "Sid": "SsmReadLouParametersOnly",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:DescribeParameters",
        "ssm:PutParameter",
        "ssm:AddTagsToResource"
      ],
      "Resource": "arn:aws:ssm:us-east-1:${AWS_ACCOUNT_ID}:parameter/lou/*"
    },
    {
      "Sid": "CdkBootstrapVersionParameterRead",
      "Comment": "CDK templates resolve BootstrapVersion from SSM at changeset time. Read-only, lou0 only.",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": "arn:aws:ssm:us-east-1:${AWS_ACCOUNT_ID}:parameter/cdk-bootstrap/lou0/*"
    },
    {
      "Sid": "KmsDecryptForSsmSecureStringsOnly",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.us-east-1.amazonaws.com"
        }
      }
    },
    {
      "Sid": "CloudFrontHasNoResourceLevelPermissionsSeeReadme",
      "Comment": "CloudFront has no resource-level scoping (README). Tag-aware + origin-request-policy calls: CloudFormation needs them.",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateDistribution",
        "cloudfront:UpdateDistribution",
        "cloudfront:DeleteDistribution",
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "cloudfront:ListDistributions",
        "cloudfront:TagResource",
        "cloudfront:CreateOriginAccessControl",
        "cloudfront:GetOriginAccessControl",
        "cloudfront:UpdateOriginAccessControl",
        "cloudfront:DeleteOriginAccessControl",
        "cloudfront:ListOriginAccessControls",
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation",
        "cloudfront:CreateCachePolicy",
        "cloudfront:GetCachePolicy",
        "cloudfront:DeleteCachePolicy",
        "cloudfront:CreateResponseHeadersPolicy",
        "cloudfront:GetResponseHeadersPolicy",
        "cloudfront:DeleteResponseHeadersPolicy",
        "cloudfront:CreateDistributionWithTags",
        "cloudfront:ListTagsForResource",
        "cloudfront:UntagResource",
        "cloudfront:CreateOriginRequestPolicy",
        "cloudfront:GetOriginRequestPolicy",
        "cloudfront:UpdateOriginRequestPolicy",
        "cloudfront:DeleteOriginRequestPolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WafV2ForCloudFrontSeeReadme",
      "Effect": "Allow",
      "Action": [
        "wafv2:CreateWebACL",
        "wafv2:UpdateWebACL",
        "wafv2:DeleteWebACL",
        "wafv2:GetWebACL",
        "wafv2:ListWebACLs",
        "wafv2:AssociateWebACL",
        "wafv2:DisassociateWebACL",
        "wafv2:TagResource",
        "wafv2:ListTagsForResource"
      ],
      "Resource": "*"
    }
  ]
}
