{
  "Version": "2012-10-17",
  "Comment": "Permissions boundary for every role the Lou stack creates -- chiefly the Lambda execution role. This is the RUNTIME ceiling: what the running function may do, which is far less than what the deploy role may create. lou-service-policy.json denies creating any lou/ role without this boundary attached, which is what closes the privilege-escalation path opened by granting iam:CreateRole.",
  "Statement": [
    {
      "Sid": "WriteItsOwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents", "logs:CreateLogGroup"],
      "Resource": [
        "arn:aws:logs:us-east-1:${AWS_ACCOUNT_ID}:log-group:/aws/lambda/lou-*",
        "arn:aws:logs:us-east-1:${AWS_ACCOUNT_ID}:log-group:/aws/lambda/lou-*:*"
      ]
    },
    {
      "Sid": "ReadWriteItsOwnStateTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:ConditionCheckItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:${AWS_ACCOUNT_ID}:table/lou-*",
        "arn:aws:dynamodb:us-east-1:${AWS_ACCOUNT_ID}:table/lou-*/index/*"
      ]
    },
    {
      "Sid": "ReadItsOwnSecrets",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": "arn:aws:ssm:us-east-1:${AWS_ACCOUNT_ID}:parameter/lou/*"
    },
    {
      "Sid": "DecryptThoseSecureStringsAndNothingElse",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": { "kms:ViaService": "ssm.us-east-1.amazonaws.com" }
      }
    },
    {
      "Sid": "ReadBuildInputsFromItsOwnBuckets",
      "Comment": "Account-suffixed for the same reason as the service policy: S3 bucket ARNs have no account field and the name namespace is global, so arn:aws:s3:::lou-* alone would also match another customer's bucket.",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::lou-*-${AWS_ACCOUNT_ID}-us-east-1",
        "arn:aws:s3:::lou-*-${AWS_ACCOUNT_ID}-us-east-1/*"
      ],
      "Condition": {
        "StringEquals": { "aws:ResourceAccount": "${AWS_ACCOUNT_ID}" }
      }
    },
    {
      "Sid": "S3ResourceAccountPin",
      "Comment": "The runtime must never reach a bucket outside this account, whatever it is named.",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": "*",
      "Condition": {
        "StringNotEqualsIfExists": { "aws:ResourceAccount": "${AWS_ACCOUNT_ID}" }
      }
    },
    {
      "Sid": "EmitItsOwnMetrics",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*",
      "Condition": {
        "StringEquals": { "cloudwatch:namespace": "Lou" }
      }
    },
    {
      "Sid": "TheRuntimeNeverEscalatesOrReachesSideways",
      "Effect": "Deny",
      "Action": [
        "iam:*",
        "sts:AssumeRole",
        "organizations:*",
        "account:*",
        "ec2:*",
        "rds:*",
        "lambda:CreateFunction",
        "lambda:UpdateFunctionCode",
        "dynamodb:DeleteTable",
        "s3:DeleteBucket"
      ],
      "Resource": "*"
    }
  ]
}
