# Cerebras retired its always-free tier in July 2026 (an expired $5 trial now
# returns HTTP 402 payment_required on every call), so the paid key is normally
# the only one set. CEREBRAS_API_KEY is optional: leave it empty and the app
# uses CEREBRAS_PAID_API_KEY as its primary key.
CEREBRAS_API_KEY=
CEREBRAS_PAID_API_KEY=your-paid-tier-key-here
MODEL=gpt-oss-120b
LLM_BASE_URL=https://api.cerebras.ai/v1
